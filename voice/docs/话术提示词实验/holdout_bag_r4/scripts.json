        "block_ordinal": 6,
        "stage": "benefit",
        "ordinal": 15,
        "text": "它配的是长肩带，可以手提，也可以单肩背。",
        "spoken_text": "它配的是长肩带，可以手提，也可以单肩背。",
        "kind": "product_claim",
