      {
        "id": "script_df815ba8066941ad_s014",
        "block_id": "script_df815ba8066941ad_b005",
        "block_ordinal": 5,
        "stage": "benefit",
        "ordinal": 14,
        "text": "你不用每天小心翼翼，当成日常消耗品来用就行。",
        "spoken_text": "你不用每天小心翼翼，当成日常消耗品来用就行。",
        "kind": "product_claim",
        "fact_ids": [
