        "block_ordinal": 4,
        "stage": "benefit",
        "ordinal": 8,
        "text": "先看这个可折叠的特点。",
        "spoken_text": "先看这个可折叠的特点。",
        "kind": "product_claim",
        "fact_ids": [
          "SELLING"
