        "block_ordinal": 1,
        "stage": "welcome",
        "ordinal": 2,
        "text": "你平时在家喝水、喝茶，更习惯用哪种杯子？",
        "spoken_text": "你平时在家喝水、喝茶，更习惯用哪种杯子？",
        "kind": "engagement",
