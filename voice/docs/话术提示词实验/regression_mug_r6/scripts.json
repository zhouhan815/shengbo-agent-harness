        "block_ordinal": 4,
        "stage": "benefit",
        "ordinal": 9,
        "text": "你不用整只手包着杯身，拿放之间会自在一些。",
        "spoken_text": "你不用整只手包着杯身，拿放之间会自在一些。",
        "kind": "product_claim",
