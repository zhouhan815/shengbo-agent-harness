        "block_ordinal": 6,
        "stage": "benefit",
        "ordinal": 13,
        "text": "容量方面，这只杯子是三百五十毫升。",
        "spoken_text": "容量方面，这只杯子是三百五十毫升。",
        "kind": "product_claim",
        "fact_ids": [
