        "block_id": "script_c03be503642c42cb_b001",
        "block_ordinal": 1,
        "stage": "welcome",
        "ordinal": 2,
        "text": "你平时在家喝水、喝咖啡，最顺手的那只杯子长什么样？",
        "spoken_text": "你平时在家喝水、喝咖啡，最顺手的那只杯子长什么样？",
