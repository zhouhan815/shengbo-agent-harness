      {
        "id": "script_c03be503642c42cb_s008",
        "block_id": "script_c03be503642c42cb_b004",
        "block_ordinal": 4,
        "stage": "benefit",
        "ordinal": 8,
        "text": "在家泡好茶，或者从厨房端杯热水去客厅，手指往把手上一扣就能走。",
        "spoken_text": "在家泡好茶，或者从厨房端杯热水去客厅，手指往把手上一扣就能走。",
        "kind": "product_claim",
        "fact_ids": [
          "SELLING"
