        "block_id": "script_1dac6a56563b4fd0_b004",
        "block_ordinal": 4,
        "stage": "benefit",
        "ordinal": 8,
        "text": "先说说这个软封面，它不像硬壳本那样支棱着。",
        "spoken_text": "先说说这个软封面，它不像硬壳本那样支棱着。",
        "kind": "product_claim",
        "fact_ids": [
