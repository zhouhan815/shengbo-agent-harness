        "block_id": "script_1dac6a56563b4fd0_b003",
        "block_ordinal": 3,
        "stage": "identity",
        "ordinal": 6,
        "text": "它是A5尺寸，八十页，软封面，内页是点阵格式。",
        "spoken_text": "它是A5尺寸，八十页，软封面，内页是点阵格式。",
