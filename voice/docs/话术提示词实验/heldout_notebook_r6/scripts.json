        "block_id": "script_1dac6a56563b4fd0_b003",
        "block_ordinal": 3,
        "stage": "identity",
        "ordinal": 7,
        "text": "封面有浅灰和浅绿两种颜色可以选。",
        "spoken_text": "封面有浅灰和浅绿两种颜色可以选。",
        "kind": "product_claim",
        "fact_ids": [
          "SELLING"
