      },
      {
        "id": "script_6b514114e090453a_s007",
        "block_id": "script_6b514114e090453a_b004",
        "block_ordinal": 4,
        "stage": "benefit",
        "ordinal": 7,
        "text": "内部还有一个小口袋，钥匙、门禁卡、耳机这些小东西可以单独放。",
        "spoken_text": "内部还有一个小口袋，钥匙、门禁卡、耳机这些小东西可以单独放。",
        "kind": "product_claim",
        "fact_ids": [
          "SELLING"
        ]
      },
      {
        "id": "script_6b514114e090453a_s008",
        "block_id": "script_6b514114e090453a_b004",
        "block_ordinal": 4,
        "stage": "benefit",
        "ordinal": 8,
        "text": "到公司或者回家开门时，不用在包里翻半天，随手就能摸到。",
        "spoken_text": "到公司或者回家开门时，不用在包里翻半天，随手就能摸到。",
        "kind": "product_claim",
        "fact_ids": [
          "SELLING"
        ]
      },
      {
        "id": "script_6b514114e090453a_s009",
        "block_id": "script_6b514114e090453a_b005",
        "block_ordinal": 5,
        "stage": "benefit",
        "ordinal": 9,
        "text": "它配的是长肩带，可以手提，也能单肩背着。",
        "spoken_text": "它配的是长肩带，可以手提，也能单肩背着。",
        "kind": "product_claim",
        "fact_ids": [
          "SELLING"
