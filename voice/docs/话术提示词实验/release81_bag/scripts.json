        "block_ordinal": 2,
        "stage": "pain",
        "ordinal": 2,
        "text": "每天出门前，是不是总在纠结背哪个包？",
        "spoken_text": "每天出门前，是不是总在纠结背哪个包？",
        "kind": "engagement",
