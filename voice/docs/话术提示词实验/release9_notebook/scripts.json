      {
        "id": "script_472d724988ec4137_s005",
        "block_id": "script_472d724988ec4137_b003",
        "block_ordinal": 3,
        "stage": "identity",
        "ordinal": 5,
        "text": "咱们今天看的是轻记A5点阵笔记本，A5尺寸配软封面，拿在手里是那种比较轻便的感觉。",
        "spoken_text": "咱们今天看的是轻记A5点阵笔记本，A5尺寸配软封面，拿在手里是那种比较轻便的感觉。",
        "kind": "product_claim",
        "fact_ids": [
          "NAME",
          "SELLING"
        ]
      },
      {
        "id": "script_472d724988ec4137_s006",
        "block_id": "script_472d724988ec4137_b004",
        "block_ordinal": 4,
        "stage": "benefit",
        "ordinal": 6,
        "text": "它里面是点阵格式的内页，不是横线也不是空白。",
        "spoken_text": "它里面是点阵格式的内页，不是横线也不是空白。",
        "kind": "product_claim",
        "fact_ids": [
          "SELLING"
