        "block_id": "script_3c466f46470a4612_b008",
        "block_ordinal": 8,
        "stage": "specification",
        "ordinal": 15,
        "text": "规格就一个，三百五十毫升，米白色，带把手。",
        "spoken_text": "规格就一个，三百五十毫升，米白色，带把手。",
        "kind": "product_claim",
        "fact_ids": [
