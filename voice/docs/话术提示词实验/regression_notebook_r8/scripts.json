        "block_ordinal": 1,
        "stage": "welcome",
        "ordinal": 3,
        "text": "可以一边听一边想想自己最需要什么样的本子。",
        "spoken_text": "可以一边听一边想想自己最需要什么样的本子。",
        "kind": "engagement",
